{
  "info": {
    "_postman_id": "satusehat-registration-flow",
    "name": "SATUSEHAT Patient Registration Flow",
    "description": "Koleksi request untuk simulasi pendaftaran pasien ke SATUSEHAT Platform (Sandbox). Menggunakan Request Body JSON untuk validasi Pydantic.\n\nUrutan: Step 1 → 2a → 2b → 3 → 4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "patient_ihs_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "practitioner_ihs_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "location_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Step 1 - Get Access Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.access_token) {",
              "  pm.collectionVariables.set('token', json.access_token);",
              "  console.log('Token saved');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/registration/token",
          "host": ["{{base_url}}"],
          "path": ["registration", "token"]
        },
        "description": "Mendapatkan OAuth2 access token. Token disimpan otomatis ke variabel 'token'."
      },
      "response": []
    },
    {
      "name": "Step 2a - Get Patient IHS by NIK",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.ihsNumber) {",
              "  pm.collectionVariables.set('patient_ihs_id', json.ihsNumber);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/registration/patient-ihs?token={{token}}&nik=9271060312000001",
          "host": ["{{base_url}}"],
          "path": ["registration", "patient-ihs"],
          "query": [
            { "key": "token", "value": "{{token}}" },
            { "key": "nik", "value": "9271060312000001" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Step 2b - Get Practitioner IHS by NIK",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.ihsNumber) {",
              "  pm.collectionVariables.set('practitioner_ihs_id', json.ihsNumber);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/registration/practitioner-ihs?token={{token}}&nik=1000000000000002",
          "host": ["{{base_url}}"],
          "path": ["registration", "practitioner-ihs"],
          "query": [
            { "key": "token", "value": "{{token}}" },
            { "key": "nik", "value": "1000000000000002" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Step 3 - Create Location",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.id) {",
              "  pm.collectionVariables.set('location_id', json.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Ruang Poli Umum\",\n    \"description\": \"Simulasi Ruangan Rawat Jalan\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/registration/location?token={{token}}",
          "host": ["{{base_url}}"],
          "path": ["registration", "location"],
          "query": [{ "key": "token", "value": "{{token}}" }]
        }
      },
      "response": []
    },
    {
      "name": "Step 4 - Create Encounter",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"patient_ihs\": \"{{patient_ihs_id}}\",\n    \"practitioner_ihs\": \"{{practitioner_ihs_id}}\",\n    \"location_id\": \"{{location_id}}\",\n    \"description\": \"Kunjungan Pemeriksaan Rutin\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/registration/encounter?token={{token}}",
          "host": ["{{base_url}}"],
          "path": ["registration", "encounter"],
          "query": [{ "key": "token", "value": "{{token}}" }]
        }
      },
      "response": []
    },
    {
      "name": "[ALL-IN-ONE] Run Full Registration Flow",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/registration/run-full-flow?nik_pasien=9271060312000001&ihs_dokter=10006926841&location_name=Ruang%20Poli%20Umum",
          "host": ["{{base_url}}"],
          "path": ["registration", "run-full-flow"],
          "query": [
            { "key": "nik_pasien", "value": "9271060312000001" },
            { "key": "ihs_dokter", "value": "10006926841" },
            { "key": "location_name", "value": "Ruang Poli Umum" }
          ]
        }
      },
      "response": []
    }
  ]
}